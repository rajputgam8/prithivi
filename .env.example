# ============================================================================
# PRITHIVI environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
#     cp .env.example .env && chmod 600 .env
#
# Phase 1 requires only the CORE block below. Everything else has safe
# defaults and is documented in ARCHITECTURE.md section 16.
# ============================================================================

# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------
PRITHIVI_ENV=dev                       # dev | prod  (prod enforces secret + log rules)
PRITHIVI_LLM_PROVIDER=openai_compatible # openai_compatible | anthropic | local
PRITHIVI_LLM_BASE_URL=https://api.openai.com/v1
PRITHIVI_LLM_API_KEY=                  # SECRET - never commit, never logged
PRITHIVI_LLM_MODEL=gpt-4o-mini
PRITHIVI_LLM_TEMPERATURE=0.2
PRITHIVI_LLM_MAX_TOKENS=1024
PRITHIVI_LLM_TIMEOUT_S=60
PRITHIVI_LLM_STREAM=true               # speak/print the reply as it is generated (lower latency)

# For voice, a small, fast model feels far more responsive than a large one.
# Check what your key can actually use first:  curl -s $PRITHIVI_LLM_BASE_URL/models -H "Authorization: Bearer $PRITHIVI_LLM_API_KEY"
# On Groq, fast + tool-capable choices include: openai/gpt-oss-20b (fastest),
# openai/gpt-oss-120b (stronger), qwen/qwen3-32b. A model your key cannot access
# returns HTTP 404 "model_not_found", which is the usual cause of "nothing happens".

# PRITHIVI_LLM_PROVIDER=anthropic
# PRITHIVI_LLM_BASE_URL=https://api.anthropic.com/v1
# PRITHIVI_LLM_MODEL=claude-sonnet-5
# PRITHIVI_LLM_API_KEY=

# PRITHIVI_LLM_PROVIDER=local          # llama.cpp / Ollama / LM Studio
# PRITHIVI_LLM_BASE_URL=http://localhost:11434/v1
# PRITHIVI_LLM_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------------
# RUNTIME / STORAGE
# ---------------------------------------------------------------------------
PRITHIVI_DATA_DIR=./data              # db, vectors, audio, screenshots
PRITHIVI_LOG_LEVEL=INFO               # DEBUG enables verbose tool tracing
PRITHIVI_LOG_FORMAT=text              # text | json
PRITHIVI_PERMISSION_DEFAULT_LEVEL=2   # baseline gating: 0..4
PRITHIVI_CONFIRMATION_TIMEOUT_S=120
PRITHIVI_AGENT_MAX_ITERATIONS=6
PRITHIVI_AGENT_TURN_BUDGET_S=45
PRITHIVI_MASTER_KEY=                  # SECRET - required when PRITHIVI_ENV=prod

# ---------------------------------------------------------------------------
# NETWORK / PRIVACY
# ---------------------------------------------------------------------------
PRITHIVI_EGRESS_ALLOW_NETWORK=true    # false = fully offline operation
PRITHIVI_EGRESS_ALLOWED_HOSTS=        # comma separated glob hosts; empty = any
                                      # public host (private/loopback always refused)
PRITHIVI_MEMORY_ENABLED=true          # set false to disable long-term memory entirely
PRITHIVI_AUDIT_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# PHASE 2 - VOICE (implemented: Android via Termux:API)
# ---------------------------------------------------------------------------
PRITHIVI_WAKE_WORD=hey prithivi
PRITHIVI_WAKE_WORD_ENABLED=true
PRITHIVI_STT_PROVIDER=termux           # termux (android recogniser via Termux:API)
PRITHIVI_TTS_PROVIDER=termux           # termux | silent
PRITHIVI_TTS_RATE=1.0                  # 0.5 (half speed) .. 2.0 (double)
PRITHIVI_TTS_PITCH=1.0                 # 0.5 (deep) .. 2.0 (high); ~0.95 sounds warmer
PRITHIVI_TTS_VOICE=                    # optional engine voice name (termux -n); lists depend on the engine
PRITHIVI_STT_LANGUAGE=auto             # advisory only for the termux backend:
                                       # the recogniser follows the device locale
# Future backends (not implemented yet): faster_whisper STT, piper TTS.
PRITHIVI_BARGE_IN_ENABLED=true
# Streaming replies are spoken sentence-by-sentence so the first words start
# quickly. Termux:API calls have a fixed cost (seconds on PRoot, milliseconds
# natively); when the first spoken chunk takes at least SLOW_AFTER_S, later
# sentences are coalesced into COALESCE_CHARS-sized chunks so that cost is paid
# once, not once per sentence. Raise SLOW_AFTER_S to always stream.
PRITHIVI_TTS_SLOW_AFTER_S=1.5
PRITHIVI_TTS_COALESCE_CHARS=220

# ---------------------------------------------------------------------------
# PHASE 3 - COMPUTER CONTROL (unused until Phase 3)
# ---------------------------------------------------------------------------
PRITHIVI_FS_ALLOWED_ROOTS=./data,~/Documents,~/Desktop
PRITHIVI_BROWSER=chromium             # chromium | firefox | webkit
PRITHIVI_BROWSER_HEADLESS=false

# ---------------------------------------------------------------------------
# PHASE 4/5 - VISION (unused until Phase 4)
# ---------------------------------------------------------------------------
PRITHIVI_CAMERA_INDEX=0
PRITHIVI_VISION_MAX_FPS=20
PRITHIVI_VISION_WIDTH=640
PRITHIVI_VISION_HEIGHT=480
PRITHIVI_GESTURE_CONFIDENCE=0.75
PRITHIVI_GESTURE_HOLD_MS=250
PRITHIVI_GESTURE_COOLDOWN_MS=800
PRITHIVI_CURSOR_SENSITIVITY=1.0

# ---------------------------------------------------------------------------
# PHASE 6 - WEB INTELLIGENCE
# ---------------------------------------------------------------------------
PRITHIVI_SEARCH_PROVIDER=duckduckgo   # duckduckgo (keyless) | serper | brave | tavily | searxng
PRITHIVI_SEARCH_API_KEY=              # SECRET; required by serper/brave/tavily
PRITHIVI_SEARCH_ENDPOINT=             # for searxng, e.g. https://searx.be
PRITHIVI_SEARCH_TIMEOUT_S=15
PRITHIVI_WEB_FETCH_TIMEOUT_S=15
PRITHIVI_WEB_FETCH_MAX_BYTES=2000000  # hard cap per page
PRITHIVI_WEB_RESPECT_ROBOTS=true      # no supported way to disable this
PRITHIVI_WEB_USER_AGENT=Prithivi/0.6 (+https://github.com/prithivi)
PRITHIVI_WEB_MAX_CHARS_PER_PAGE=4000  # characters of article text per page
PRITHIVI_RESEARCH_MAX_SOURCES=8       # hard cap; values above 8 are clamped
PRITHIVI_RESEARCH_BUDGET_S=20         # hard cap; values above 20 are clamped
PRITHIVI_REMEMBER_RESEARCH=false      # persist fetched research into the knowledge base

# ---------------------------------------------------------------------------
# PHASE 7 - RAG + MEMORY (unused until Phase 7)
# ---------------------------------------------------------------------------
PRITHIVI_VECTOR_BACKEND=sqlite_vec    # sqlite_vec | pgvector
PRITHIVI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PRITHIVI_EMBEDDING_DIM=384
PRITHIVI_CHUNK_SIZE=512
PRITHIVI_CHUNK_OVERLAP=64
PRITHIVI_RETRIEVAL_TOP_K=8

# ---------------------------------------------------------------------------
# PHASE 8 - SOCIAL OAUTH (unused until Phase 8)
# ---------------------------------------------------------------------------
PRITHIVI_OAUTH_CALLBACK_HOST=127.0.0.1
PRITHIVI_OAUTH_CALLBACK_PORT=8765
PRITHIVI_YOUTUBE_API_KEY=             # SECRET
PRITHIVI_SPOTIFY_CLIENT_ID=           # SECRET
PRITHIVI_SPOTIFY_CLIENT_SECRET=       # SECRET
PRITHIVI_DISCORD_BOT_TOKEN=           # SECRET

# ---------------------------------------------------------------------------
# PHASE 9 - AUTOMATION (unused until Phase 9)
# ---------------------------------------------------------------------------
PRITHIVI_NOTIFICATION_LEVEL=normal    # off | low | normal | high
PRITHIVI_SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# PHASE 10 - UI / API (unused until Phase 10)
# ---------------------------------------------------------------------------
PRITHIVI_API_HOST=127.0.0.1
PRITHIVI_API_PORT=8000
PRITHIVI_API_TOKEN=                   # SECRET - bearer token for the API
PRITHIVI_API_ALLOW_REMOTE=false